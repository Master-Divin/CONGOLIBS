# API Django/DRF
VITE_API_URL=https://ledevfreelance.pythonanywhere.com/api/v1

# Google Identity Services
# Créez un Web Client ID dans Google Cloud Console et ajoutez votre domaine Vercel
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Endpoint backend qui vérifie le credential Google et renvoie le même format que login-mobile
# { "token": "...", "user": { ... } }
VITE_GOOGLE_AUTH_PATH=/users/auth/google/
